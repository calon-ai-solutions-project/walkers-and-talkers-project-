# Walkers & Talkers — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# --- Frontend (safe to ship in the browser bundle) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_APP_DOMAIN=walkersandtalkers.org

# --- Server-side scripts ONLY (scripts/import_members.ts) ---
# The service_role key bypasses ALL Row Level Security. It must never appear
# in any file under src/ or in the deployed frontend. It lives only in
# .env.local for one-off CLI scripts.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
