{
  "name": "wt-nfc-writer",
  "productName": "Walkers & Talkers NFC Writer",
  "version": "1.0.0",
  "description": "Writes Walkers & Talkers NFC cards via an ACR122U reader on macOS.",
  "main": "src/main.cjs",
  "author": "Calon AI Solutions",
  "license": "UNLICENSED",
  "repository": "https://github.com/calon-ai-solutions-project/walkers-and-talkers-project-",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --publish never"
  },
  "build": {
    "appId": "uk.org.walkersandtalkers.nfcwriter",
    "productName": "Walkers & Talkers NFC Writer",
    "files": ["src/**/*"],
    "protocols": [
      { "name": "NFC Writer", "schemes": ["nfcwriter"] }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg"],
      "identity": null
    },
    "dmg": {
      "title": "Walkers & Talkers NFC Writer"
    }
  },
  "dependencies": {
    "nfc-pcsc": "^0.8.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
